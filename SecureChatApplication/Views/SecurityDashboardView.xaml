<UserControl x:Class="SecureChatApplication.Views.SecurityDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#1E1E2E"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- Card style -->
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="#252536"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>

        <!-- Small action button -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3D3D5C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4B4B6B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D3D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#2D2D3D"/>
                                <Setter Property="Foreground" Value="#4B4B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent (purple) button -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8B5CF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger (red) button for simulations -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#991B1B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#450A0A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter text box -->
        <Style x:Key="FilterTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3D3D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Header ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="🛡️ Security Dashboard"
                           FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12" Foreground="#8B8BA3" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource AccentButton}"
                        Content="⟳ Refresh"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0"/>
                <Button Style="{StaticResource ActionButton}"
                        Content="Back to Chat"
                        Click="BackToChat_Click"/>
            </StackPanel>
        </Grid>

        <!-- ═══ Row 1: Summary Cards ═══ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <!-- Threat Level -->
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Threat Level" Foreground="#8B8BA3" FontSize="11"/>
                    <TextBlock Text="{Binding ThreatLevel}"
                               FontSize="22" FontWeight="Bold"
                               Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#10B981"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThreatLevel}" Value="Elevated">
                                        <Setter Property="Foreground" Value="#EAB308"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ThreatLevel}" Value="High">
                                        <Setter Property="Foreground" Value="#F97316"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ThreatLevel}" Value="Critical">
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Active Users -->
            <Border Style="{StaticResource DashboardCard}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="Active Users" Foreground="#8B8BA3" FontSize="11"/>
                    <TextBlock Text="{Binding ActiveUserCount}"
                               FontSize="22" FontWeight="Bold" Foreground="#3B82F6"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Alerts -->
            <Border Style="{StaticResource DashboardCard}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="Total Alerts" Foreground="#8B8BA3" FontSize="11"/>
                    <TextBlock Text="{Binding AlertCount}"
                               FontSize="22" FontWeight="Bold" Foreground="#EAB308"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- High-Risk -->
            <Border Style="{StaticResource DashboardCard}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="High Risk" Foreground="#8B8BA3" FontSize="11"/>
                    <TextBlock Text="{Binding HighRiskCount}"
                               FontSize="22" FontWeight="Bold" Foreground="#EF4444"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══ Row 2: Filter + Simulation ═══ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Filter bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Style="{StaticResource FilterTextBox}"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Filter alerts &amp; logs..."
                         Margin="0,0,8,0"/>

                <Button Grid.Column="1"
                        Style="{StaticResource ActionButton}"
                        Content="✕ Clear"
                        Command="{Binding ClearFilterCommand}"/>
            </Grid>

            <!-- Simulation buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                <TextBlock Text="Simulate:" Foreground="#6B6B8A" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Style="{StaticResource DangerButton}"
                        Content="Brute Force"
                        Command="{Binding SimulateBruteForceCommand}"
                        Margin="0,0,4,0"/>
                <Button Style="{StaticResource DangerButton}"
                        Content="Flood"
                        Command="{Binding SimulateFloodCommand}"
                        Margin="0,0,4,0"/>
                <Button Style="{StaticResource DangerButton}"
                        Content="Fake Key"
                        Command="{Binding SimulateFakeKeyCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Simulation result -->
        <TextBlock Text="{Binding SimulationResult}"
                   Foreground="#EAB308" FontSize="11"
                   Margin="0,-8,0,8" Grid.Row="2"
                   VerticalAlignment="Bottom"
                   Visibility="{Binding SimulationResult, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- ═══ Row 3: Alerts & Logs (split) ═══ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Alerts Panel ── -->
            <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="⚠ Security Alerts"
                               FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"
                               Margin="0,0,0,12"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredAlerts}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2D2D3D" CornerRadius="8" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Severity icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Severity, Converter={StaticResource SeverityToIconConverter}}"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding AlertType}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"/>
                                                <TextBlock Text="{Binding Severity, StringFormat=' [{0}]'}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Foreground="#6B6B8A" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Details}"
                                                       FontSize="11" Foreground="#8B8BA3"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <TextBlock FontSize="10" Foreground="#4B4B6B" Margin="0,2,0,0">
                                                <Run Text="{Binding Username, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding IpAddress, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Timestamp -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                   FontSize="10" Foreground="#4B4B6B"
                                                   VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <TextBlock Grid.Row="1"
                               Text="No alerts"
                               Foreground="#4B4B6B" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding AlertCount, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- ── Logs Panel ── -->
            <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="📋 Event Logs"
                               FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"
                               Margin="0,0,0,12"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredLogs}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2D2D3D" CornerRadius="6" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding IsSuccessful, Converter={StaticResource BoolToStatusIconConverter}}"
                                                   Foreground="{Binding IsSuccessful, Converter={StaticResource BoolToStatusBrushConverter}}"
                                                   FontSize="13" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding EventType}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#B8B8D1"/>
                                                <TextBlock Text="{Binding Username, StringFormat=' · {0}'}"
                                                           FontSize="11" Foreground="#6B6B8A"
                                                           Visibility="{Binding Username, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Details}"
                                                       FontSize="10" Foreground="#6B6B8A"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Timestamp -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                   FontSize="10" Foreground="#4B4B6B"
                                                   VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading overlay -->
        <Border Grid.RowSpan="4"
                Background="#80000000"
                CornerRadius="12"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⟳" FontSize="28" Foreground="#7C3AED"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Loading security data..."
                           FontSize="13" Foreground="#B8B8D1"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
